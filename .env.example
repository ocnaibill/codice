# ============================================================
# Códice — Environment Configuration
# Copy this file to .env and edit values for your environment
# ============================================================

# ---------- Application ----------
APP_ENV=development                    # 'development' or 'production'
# There is no authentication bypass in any environment: every request needs a session.

# ---------- PostgreSQL ----------
POSTGRES_USER=codice_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=codice_db
POSTGRES_HOST=localhost                 # Use 'postgres' for Docker
POSTGRES_PORT=5432

# Connection URL (assembled from above, or set directly)
DATABASE_URL=postgres://codice_user:change_me_in_production@localhost:5432/codice_db?sslmode=disable

# ---------- Redis ----------
REDIS_HOST=localhost                    # Use 'redis' for Docker
REDIS_PORT=6379
# Required by docker-compose.full.yml; optional for docker-compose.yml. Use a URL-safe
# value, e.g. `openssl rand -hex 24`, and include it in REDIS_URL:
# REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0      # With a password: redis://:PASSWORD@localhost:6379/0

# ---------- Storage ----------
CODICE_STORAGE_PATH=./uploads           # Absolute path in production (e.g., /data/codice)
# Directories the admin bulk import may read, besides <storage>/import (always allowed).
# Absolute paths separated by ':' (like PATH). Symlinks are never followed out of a root.
# CODICE_IMPORT_ROOTS=/mnt/library:/home/me/books

# ---------- Uploads and background jobs ----------
CODICE_MAX_UPLOAD_MB=1024               # Largest file accepted by upload and bulk import (a real limit on the body)
WORKER_POLL_SECONDS=5                   # How often a worker looks for jobs when Redis does not wake it (Redis is optional)
JOB_LEASE_SECONDS=120                   # A job whose worker is silent this long is taken over by another worker
JOBS_MAX_CONCURRENT=1                   # Heavy jobs running at once, across all workers (default: one)

# ---------- Backend Server ----------
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173    # Comma-separated for multiple origins

# ---------- Authentication ----------
# Required in every environment: the API refuses to start without it. Generate with `openssl rand -hex 32`.
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
# How long a login lasts unless revoked earlier (whole hours, 1 to 8760). Default: 168 (7 days).
JWT_EXPIRATION_HOURS=168

# ---------- LDAP sign-in (Optional) ----------
# Leave LDAP_URL unset to keep LDAP off. When set, the API refuses to start with an unsafe or
# incomplete configuration. It needs LDAPS, or ldap:// with StartTLS (the default): credentials
# never travel in the clear. The owner still signs in with a local password, always.
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_BIND_DN=cn=codice-svc,ou=users,dc=example,dc=com       # read-only service account
# LDAP_BIND_PASSWORD=                   # or LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind
# LDAP_BASE_DN=dc=example,dc=com       # search ONLY where the people are (e.g. ou=users,...): Authentik also keeps a
#                                       # virtual group with the same name AND id per user, which makes a whole-tree search ambiguous
# LDAP_USER_FILTER=(uid={username})     # {username} is escaped before use
# LDAP_USERNAME_ATTR=uid                # what people type at the login form
# LDAP_ID_ATTR=entryUUID                # STABLE identifier an account is linked to; never the name (Authentik: uid)
# LDAP_EMAIL_ATTR=mail
# LDAP_START_TLS=true                   # for ldap:// URLs
# LDAP_CA_FILE=/path/to/ca.pem          # only for a private CA
# Whether a first sign-in creates an account, and how often a directory account is
# re-confirmed (default 24 h), are set by the owner in the app, not here.

# ---------- Frontend (Build-time) ----------
VITE_API_URL=http://localhost:8080      # Set before 'npm run build'. Empty = relative URLs.

# ---------- Metadata Providers (Optional) ----------
# GOOGLE_BOOKS_API_KEY=                 # Optional: increases rate limit
# COMICVINE_API_KEY=                    # Required for ComicVine provider
# ANILIST_API_KEY=                      # Optional: AniList is public API