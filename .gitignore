# Global gitignore of codice

# Secrets and enviroment files
.env
.env.*
!.env.example
*.pem
*.key

# Local database folders
/library/
/tmp/
/data/

# Backend
backend/uploads/
backend/api
.exe
.exe~
*.dll
*.so
*.dylib
bin/
*.test
*.out
vendor/

# Worker
__pycache__/
*.py[cod]
*$py.class
.env_python/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Frontend
node_modules/
.npm/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.cab
*.msi
*.msm
*.msp
*.lnk

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# IntelliJ / GoLand / PyCharm
.idea/
*.iws
*.iml
*.ipr